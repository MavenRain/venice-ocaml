 (name test_sessx)
 (modules test_sessx)
 (libraries venice))

; Copy the real pure session core against a scripted attestation
; witness. Only the three opaque witness records are faked, so this
; test runs the real revalidation, CPU-policy and admission legs.
(rule
 (targets sessx_admit_impl.ml)
 (deps ../lib/sessx.ml)
 (action
  (with-stdout-to %{targets}
   (progn (echo "open Sessx_admit_fakes\n") (cat %{deps})))))

(test
