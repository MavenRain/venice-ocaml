(test
 (name test_gcmx)
 (modules test_gcmx)
 (libraries venice))

; M23 embeds the two TDX fixtures at BUILD time (D2).  embed.exe is a
; host generator: it reads one fixture and prints one OCaml line that
; binds the bytes as a string literal.  gates.sh runs a suite from the
; repository root and dune test runs it from _build/default/test, so a
; relative fixture path would be correct in at most one of the two;  an
; embedded literal is correct in both, and a missing or renamed fixture
; breaks the BUILD instead of reddening the suite.
(executable
 (name embed)
 (modules embed))

(rule
 (targets fixture_v4.ml)
 (deps ../fixtures/tdx_quote_v4.bin)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(rule
 (targets fixture_v5.ml)
 (deps ../fixtures/tdx_quote_v5.bin)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(test
 (name test_quotex)
 (modules test_quotex fixture_v4 fixture_v5)
 (libraries venice sha2))

; M24 embeds the SAME v4 fixture a third time (D2).  A dune module
; belongs to exactly ONE stanza, and fixture_v4 already belongs to the
; test_quotex stanza above, so the policy suite owns its own generated
; module and embed.ml is not edited.
(rule
 (targets fixture_policy.ml)
 (deps ../fixtures/tdx_quote_v4.bin)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(test
 (name test_policyx)
 (modules test_policyx fixture_policy)
 (libraries venice sha2))

; M25 embeds the SAME v4 fixture a FOURTH time (D2).  A dune module
; belongs to exactly ONE stanza, and fixture_v4 and fixture_policy are
; both taken, so the signature suite owns its own generated module and
; embed.ml is not edited.  The stanza links venice ALONE and no sha2,
; because the suite computes no digest of its own:  every digest in a
; row is a PINNED literal that the unit under test must reproduce.
(rule
 (targets fixture_sig.ml)
 (deps ../fixtures/tdx_quote_v4.bin)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(test
 (name test_sigx)
 (modules test_sigx fixture_sig)
 (libraries venice))

; M26 embeds the SAME v4 fixture a FIFTH time and the pinned Intel SGX
; Root CA file a first time (D12).  A dune module belongs to exactly
; ONE stanza, and fixture_v4, fixture_policy and fixture_sig are all
; taken, so the certificate suite owns its own two generated modules
; and embed.ml is not edited.  The stanza links sha2 beside venice,
; because group (b) recomputes the sha256 of each DER and of each tbs
; from the fixture bytes instead of quoting a digest the unit prints.
(rule
 (targets fixture_der.ml)
 (deps ../fixtures/tdx_quote_v4.bin)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(rule
 (targets fixture_root.ml)
 (deps ../fixtures/collateral/TrustedRootCA.der)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(test
 (name test_derx)
 (modules test_derx fixture_der fixture_root)
 (libraries venice sha2))

; M27 embeds the SAME v4 fixture a SIXTH time and the pinned Intel PCS
; collateral envelope a first time (D11).  A dune module belongs to
; exactly ONE stanza, and fixture_v4, fixture_policy, fixture_sig,
; fixture_der and fixture_root are all taken, so the TCB suite owns its
; own two generated modules and embed.ml is not edited.  The stanza
; links sha2 beside venice, because group (a) recomputes the envelope
; sha256 and the two document sha256 values from the embedded bytes
; through Sha2.Sha256.digest and lib/venice.mli exports no digest (A11).
(rule
 (targets fixture_tcb.ml)
 (deps ../fixtures/tdx_quote_v4.bin)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(rule
 (targets fixture_collateral.ml)
 (deps ../fixtures/collateral/tdx_quote_collateral.json)
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:embed.exe} %{deps}))))

(test
 (name test_tcbx)
 (modules test_tcbx fixture_tcb fixture_collateral)
 (libraries venice sha2))

(rule
 (targets fixture_attest_quote.ml)
 (deps ../fixtures/tdx_quote_v4.bin)
 (action (with-stdout-to %{targets} (run %{exe:embed.exe} %{deps}))))

(rule
 (targets fixture_attest_envelope.ml)
 (deps ../fixtures/attestation_synthetic_v4.json)
 (action (with-stdout-to %{targets} (run %{exe:embed.exe} %{deps}))))

(rule
 (targets fixture_attest_collateral.ml)
 (deps ../fixtures/collateral/tdx_quote_collateral.json)
 (action (with-stdout-to %{targets} (run %{exe:embed.exe} %{deps}))))

(test
 (name test_attestx)
 (modules test_attestx fixture_attest_quote fixture_attest_envelope fixture_attest_collateral)
 (libraries venice sha2))

